title: Microsoft Office Application Creates VBScript File
id: 7b6e8c2a-5f3d-4e61-a3d9-91e3c9e3d101
status: experimental
description: Detects Microsoft Office applications creating VBScript files, which may indicate malicious macro or document-based script execution.
author: CyberSec Study
date: 2026/09/11
references:
    - https://attack.mitre.org/techniques/T1059/005/
    - https://attack.mitre.org/techniques/T1204/002/
tags:
    - attack.execution
    - attack.t1059.005
    - attack.user_execution
    - attack.t1204.002
logsource:
    product: windows
    category: file_event

detection:
    selection_office:
        Image:
            - '*\WINWORD.EXE'
            - '*\EXCEL.EXE'
            - '*\POWERPNT.EXE'
            - '*\OUTLOOK.EXE'
            - '*\MSACCESS.EXE'
            - '*\MSPUB.EXE'
            - '*\ONENOTE.EXE'

    selection_vbs:
        TargetFilename|endswith:
            - '.vbs'
            - '.vbe'

    condition: selection_office and selection_vbs

falsepositives:
    - Legitimate Office automation
    - Enterprise scripts generated by Office macros
    - Administrative templates or deployment tooling

level: high
